{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/Sync-.log",
          "rollingInterval": "Hour",
          "retainedFileCountLimit": 24
        }
      }
    ]
  },
  "Logging": {
    "SqlCommands": true
  },
  "ConnectionStrings": {
    "Sql": "Server=.,14333;Database=PolicyManagementDb;User Id=sa;Password=123;TrustServerCertificate=True;"

  },
  "Redis": {
    "Connection": "127.0.0.1:6379",
    "LockKey": "rl:policy:lock",
    "LockTtlSeconds": 120,
    "LockRenewIntervalSeconds": 30
  },
  "PolicySync": {
    "SyncIntervalSeconds": 10,
    "FullSnapshotOnStartup": true,
    "PeriodicFullSnapshotEnabled": true,
    "PeriodicFullSnapshotIntervalMinutes": 140,
    "BatchSize": 1000,
    "MaxChangedRowsPerBatch": 10000
  }
}
