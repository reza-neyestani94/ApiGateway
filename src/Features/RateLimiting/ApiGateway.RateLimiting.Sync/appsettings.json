{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/Sync-.log",
          "rollingInterval": "Hour",
          "retainedFileCountLimit": 24
        }
      }
    ]
  },
  "Logging": {
    "SqlCommands": false
  },

  "ConnectionStrings": {
    "Sql": "Server=.,14333;Database=PolicyManagementDb;User Id=sa;Password=123;TrustServerCertificate=True;"

  },
  "Redis": {
    "Connection": "100.100.1.60:6379",
    "LockKey": "rl:policy:lock",
    "LockTtlSeconds": 120,
    "LockRenewIntervalSeconds": 30
  },
  "PolicySync": {
    "SyncIntervalSeconds": 20,
    "FullSnapshotOnStartup": true,
    "PeriodicFullSnapshotEnabled": true,
    "PeriodicFullSnapshotIntervalMinutes": 20,
    "BatchSize": 2000,
    "MaxChangedRowsPerBatch": 20000
  }
}
