@using MudBlazor
@using ApiGateway.Shared.Contracts.Dtos.RateLimit;

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudAlert Severity="Severity.Warning"
                      Variant="Variant.Filled"
                      Dense="true">
                Are you sure you want to delete this policy?
            </MudAlert>

            <MudPaper Class="pa-3" Outlined="true">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle2">
                        Policy Name
                    </MudText>
                    <MudText Typo="Typo.body2">
                        @Policy.PolicyName
                    </MudText>

                    <MudDivider />

                    <MudText Typo="Typo.subtitle2">
                        Service
                    </MudText>
                    <MudText Typo="Typo.body2">
                        @Policy.ServiceName
                    </MudText>

                    <MudDivider />

                    <MudText Typo="Typo.subtitle2">
                        Endpoint
                    </MudText>
                    <MudText Typo="Typo.body2">
                        @Policy.EndpointPattern
                    </MudText>      
                </MudStack>
            </MudPaper>

            <MudText Color="Color.Error" Typo="Typo.caption">
                This action will remove the policy from active records.
            </MudText>
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text"
                   Color="Color.Default"
                   OnClick="Cancel">
            Cancel
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Delete"
                   OnClick="Confirm">
            Delete
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public RateLimitPolicyListItemDto Policy { get; set; } = default!;

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void Confirm()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }
}
